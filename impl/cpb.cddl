; Standalone copy of the CPB data schema in draft Figure "CPB Data Structure".
; The RFC 9171 extension-block socket binding is specified in the draft and
; intentionally omitted here because it depends on RFC 9171's complete schema.

cpb-data = {
    ? 0: probability,         ; Default/overall probability
    ? 1: [* path-entry],      ; Per-path entries
    ? 2: uint,                ; Timestamp (CPB epoch seconds)
    ? 3: bstr,                ; Source PCE identifier (optional)
    ? 4: uint,                ; Validity duration (seconds, TTL)
    ? 5: metric-type,         ; Metric type identifier
    ? 6: probability,         ; Confidence/variance estimate
    ? 7: uint,                ; Format version (1 = this specification)
    * (int .gt 7) => any      ; Extensibility (future fields)
}

probability = float           ; See the draft's CBOR Encoding section

path-entry = [
    next-hop: eid-reference,
    probability: float
]

eid-reference = uint / tstr

metric-type = &(
    prophet-dp: 0,
    cgr-confidence: 1,
    maxprop-cost: 2,
    rapid-utility: 3,
    generic: 4,
) / uint
