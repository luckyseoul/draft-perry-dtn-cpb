; Standalone copy of the CPB data schema in draft Figure "CPB Data Structure".
; The rules eid and dtn-time, and the extension-block binding in the draft's
; Figure "CPB Extension Block Binding", come from RFC 9171 Appendix B and are
; not repeated here.

cpb-data = {
    ? 0: probability,         ; Default probability
    ? 1: [* path-entry],      ; Path probabilities (Sec 3.2)
    ? 2: dtn-time,            ; Creation time (ms); 0 = unknown
      3: eid,                 ; Producer node ID
    ? 4: uint,                ; Validity (ms); needs nonzero field 2
    ? 5: metric-type,         ; Metric type; absent = generic
    ? 6: probability,         ; Confidence (profile-defined)
    ? 7: uint,                ; Format version (1 = this document)
    ? 8: uint,                ; Profile; absent = 0 (default)
    * (uint .gt 8) => any     ; Future fields; ignored if unknown
}

probability = 0.0..1.0

path-entry = [
    next-hop: eid,            ; Next-hop node ID
    probability: probability
]

metric-type = &(
    prophet-dp:      0,       ; PRoPHET delivery predictability
    cgr-confidence:  1,       ; CGR contact confidence
    maxprop-delivery-likelihood: 2, ; MaxProp delivery likelihood
    rapid-utility:   3,       ; RAPID utility, normalized
    generic:         4,       ; Unspecified estimate
) / (uint .le 255)
